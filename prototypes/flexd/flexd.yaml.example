# EMHASS base URL
emhass_url: http://emhass:5000
# MUST match EMHASS optimization_time_step
timestep_min: 30
# prediction horizon in steps
horizon_steps: 48
# IANA name; used for standing-demand windows and template deadline rules
timezone: Europe/Berlin
# registry/ledger/plan storage
data_dir: /data
# plan marked stale after N missed cycles
stale_after_cycles: 2
# expiry cushion for Simple-API registrations without explicit expiry
default_ttl_s: 3600
# registering a NEW id beyond this many active demands is a 409 (bounds the MILP and the registry file)
max_demands: 32
# refresh bursts coalesce into one registry write per window; 0 writes on every refresh
save_debounce_s: 5
# enabled/host/port/base_topic; username/password optional
mqtt:
  enabled: true
  host: mosquitto
  port: 1883
  base_topic: flexd
# merged into every EMHASS optim call; flexd's own deferrable keys always win on conflict.
# Read once at boot: use it for scalars that never change. Forecasts and a live soc_init
# belong in runtime_params_provider below (the provider wins on overlapping keys).
extra_runtime_params:
  soc_init: 0.5
# fresh runtime parameters for every solve: a JSON object of EMHASS runtime params
# (pv_power_forecast, load_power_forecast, load_cost_forecast, prod_price_forecast,
# soc_init, ...) plus "generated_at" (ISO 8601 with offset). Exactly one of path / url.
# Older than max_age_s, missing, unreachable or unparsable: the cycle is skipped and
# reported as `stale_inputs`, the adopted plan stays; flexd never solves on old data.
# Keys flexd sets itself (deferrable lists, prediction_horizon) are dropped with a warning.
# An external relay that rebuilds EMHASS payloads today can write this document instead.
# runtime_params_provider:
#   path: /data/runtime-params.json      # or: url: http://relay:8080/runtime-params.json
#   max_age_s: 900
# recurring daily loads owned by flexd config; daily_energy_wh wins over daily_hours when both given
# non-modulating loads run in whole timesteps; a remainder of a few minutes counts as delivered
standing_demands:
  - id: waterheater
    type: generic
    nominal_power_w: 3000
    daily_hours: 5
    window: "06:00-22:00"
# trigger templates: appliance recipes with start-time-dependent deadlines. First
# bracket containing the local trigger time wins; brackets MAY wrap midnight;
# overlapping brackets are fatal at config load; gaps fall back to
# default_finish_in_h with a warning log. Re-triggering while an instance is
# still active is a pure refresh — the deadline is computed once, at first trigger.
# templates:
#   - id: dishwasher
#     type: generic
#     nominal_power_w: 2000
#     energy_wh: 1400
#     interruptible: false
#     default_finish_in_h: 8
#     deadline_rules:
#       - if_started_between: "06:00-12:00"
#         finish_by: "15:00"
#       - if_started_between: "20:00-06:00"
#         not_before: "21:30"
#         finish_by: "06:30"
